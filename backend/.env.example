# JWAS Backend Production / Development Environment Template

# Core
PROJECT_NAME="JWAS E-Commerce Platform"
ENVIRONMENT=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jwas_db

# Security & Tokens
SECRET_KEY=replace-with-a-cryptographically-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Payment Gateway (Razorpay)
# Provide your live or test credentials from dashboard.razorpay.com
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Email Provider Configuration (SMTP)
EMAIL_PROVIDER_HOST=smtp.sendgrid.net
EMAIL_PROVIDER_PORT=587
EMAIL_PROVIDER_USER=
EMAIL_PROVIDER_PASSWORD=
